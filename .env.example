# =============================================================================
# n8n-hubspot-duplicate-company-domain-fuzzy-matcher — environment template
# Copy to .env (never commit .env). The same variables are read by the n8n
# workflow through $env and by the Node.js CLI through process.env.
# Values that still start with YOUR_ are treated as "not set".
# =============================================================================

# --- Safety gates (SAFE DEFAULTS — leave these on until you have tested) -----
# DRY_RUN=true   -> read HubSpot, build the review queue, send NOTHING.
# Anything other than an explicit "false" keeps the gate on.
DRY_RUN=true

# SANDBOX_MODE=true -> refuse to run unless the HubSpot portal's accountType is
# SANDBOX or DEVELOPER_TEST (checked via GET /account-info/v3/details).
SANDBOX_MODE=true

# --- HubSpot (read-only) -----------------------------------------------------
# Private App access token. Required scope: crm.objects.companies.read
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
# Override only for EU data-hosting proxies or test doubles. Must be https://
HUBSPOT_API_BASE=https://api.hubapi.com

# --- Matching ----------------------------------------------------------------
# Pair score (0-1) at or above which two companies are queued for review.
SIMILARITY_THRESHOLD=0.85
# Hard cap on companies fetched per run.
MAX_COMPANIES=50000
# Candidate blocks larger than this are skipped and reported (protects run time).
MAX_BLOCK_SIZE=2000

# --- Delivery ------------------------------------------------------------------
# Where the review queue goes: slack | notion | slack,notion | none
NOTIFY_TARGETS=slack

# Slack incoming webhook (only needed when DRY_RUN=false and slack is a target)
SLACK_WEBHOOK_URL=YOUR_SLACK_INCOMING_WEBHOOK_URL

# Notion internal integration secret + review-queue database ID
# (only needed when DRY_RUN=false and notion is a target)
NOTION_API_KEY=YOUR_NOTION_INTEGRATION_SECRET
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID
